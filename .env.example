# STARVIA Premium API example environment
# Copy to your hosting provider's environment variable settings. Do not commit real secrets.

# Required: long random secret for signing Premium JWT tokens.
STARVIA_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Choose one PIN source:
# 1) File-backed one-time PIN store for manual payment MVP.
STARVIA_PIN_STORE_FILE=./data/premium-pins.json
# 2) Or comma-separated demo/static PINs (not recommended for production).
# STARVIA_PREMIUM_PINS=STAR199,LUCKY777

# Optional Premium metadata.
STARVIA_PREMIUM_PLAN=premium_199
STARVIA_TOKEN_TTL_SECONDS=86400

# Optional deploy CORS allowlist. Leave blank for local wildcard '*'.
# Set this in production/staging to the exact frontend origins that may call the API.
STARVIA_ALLOWED_ORIGINS=https://starvia.app,https://staging.starvia.app

# Hosting providers usually set PORT automatically.
PORT=8787
